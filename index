<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vizitka – Výkup havarovaných vozů</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,900;1,900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  * { margin:0; padding:0; box-sizing:border-box; }

  body {
    background: #181818;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    gap: 56px;
    padding: 60px 20px;
    font-family: 'Barlow', sans-serif;
  }

  .lbl {
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #333;
    margin-bottom: -46px;
  }

  /* ===== PŘEDNÍ ===== */
  .front {
    width: 420px;
    height: 236px;
    background: #080808;
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.05);
  }

  .car-img {
    position: absolute;
    right: -10px;
    bottom: 0;
    width: 72%;
    height: 110%;
    object-fit: cover;
    object-position: 28% 65%;
    opacity: 0.58;
    filter: contrast(1.1) saturate(0.55) brightness(0.8);
  }

  .fade-left {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      #080808 28%,
      rgba(8,8,8,0.88) 46%,
      rgba(8,8,8,0.25) 70%,
      transparent 100%
    );
    z-index: 1;
  }
  .fade-bottom {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8,8,8,0.65) 0%, transparent 55%);
    z-index: 1;
  }

  .top-bar {
    position: absolute;
    top: 20px;
    left: 22px;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .dot {
    width: 7px;
    height: 7px;
    background: #E8261A;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .brand {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 9px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #555;
  }

  /* Badge nakřivo jako na webu */
  .badge {
    position: absolute;
    top: 18px;
    right: 18px;
    z-index: 4;
    background: #E8261A;
    color: #fff;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-style: italic;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 3px;
    text-align: center;
    line-height: 1.3;
    transform: rotate(-4deg);
    box-shadow: 0 4px 18px rgba(192,57,43,0.55);
  }

  .front-body {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 44px 22px 22px 22px;
  }

  .headline {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-style: italic;
    font-size: 40px;
    line-height: 0.88;
    text-transform: uppercase;
    color: #fff;
    letter-spacing: -1px;
    margin-bottom: 10px;
  }
  .headline .red { color: #E8261A; display: block; }

  .sub {
    font-size: 9px;
    color: #666;
    letter-spacing: 0.8px;
    line-height: 1.7;
    font-weight: 500;
  }
  .sub strong { color: #aaa; }

  /* ===== ZADNÍ ===== */
  .back {
    width: 420px;
    height: 236px;
    background: #0f0f0f;
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.05);
    display: flex;
    align-items: stretch;
  }

  .back-left {
    position: relative;
    z-index: 2;
    flex: 1;
    padding: 20px 20px 20px 26px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .back-logo {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #fff;
  }
  .back-logo .dot { width: 6px; height: 6px; }

  .contacts { display: flex; flex-direction: column; gap: 7px; }

  .crow { display: flex; flex-direction: column; gap: 1px; }

  .clabel {
    font-size: 7px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #E8261A;
    font-weight: 600;
  }
  .cvalue {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 17px;
    color: #fff;
    line-height: 1.05;
    font-feature-settings: "tnum";
    letter-spacing: 0.3px;
  }
  /* Druhý telefon – identický styl */
  .cvalue.second {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 17px;
    color: #fff;
    line-height: 1.05;
    font-feature-settings: "tnum";
    letter-spacing: 0.3px;
  }
  .cvalue.sm { font-size: 13px; color: #ccc; }

  .hr { height: 1px; background: rgba(255,255,255,0.06); }

  .back-footer { display: flex; flex-direction: column; gap: 3px; }
  .web {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 11px;
    color: #404040;
  }
  .coverage { font-size: 8px; color: #333; letter-spacing: 0.5px; }

  .vdiv {
    width: 1px;
    background: rgba(255,255,255,0.05);
    margin: 18px 0;
    position: relative;
    z-index: 2;
    flex-shrink: 0;
  }

  .back-right {
    position: relative;
    z-index: 2;
    width: 148px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px 14px 10px 14px;
    gap: 6px;
  }

  .qr-box {
    background: #fff;
    border-radius: 7px;
    padding: 6px;
    width: 128px;
    height: 128px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .qr-box img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .qr-label {
    font-size: 7.5px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #383838;
    text-align: center;
    font-weight: 600;
  }
  .qr-sub {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: 11px;
    color: #484848;
    letter-spacing: 0.5px;
  }
</style>
</head>
<body>

<span class="lbl">Přední strana</span>

<div class="front">
  <img class="car-img" src="data:image/jpeg;base64," alt="">
  <div class="fade-left"></div>
  <div class="fade-bottom"></div>

  <div class="top-bar">
    <span class="dot"></span>
    <span class="brand">Výkup havarovaných vozů</span>
  </div>

  <div class="badge">PENÍZE<br>DO 24 H</div>

  <div class="front-body">
    <div class="headline">
      Vykupujeme
      <span class="red">havarované</span>
      vozy
    </div>
    <div class="sub">
      <strong>Americké značky · Koncern VW</strong><br>
      Celá ČR · Polsko · Slovensko · Odtah zdarma
    </div>
  </div>
</div>

<span class="lbl">Zadní strana</span>

<div class="back">
  <div class="back-left">
    <div class="back-logo">
      <span class="dot"></span>
      Výkup havarovaných vozů
    </div>

    <div class="contacts">
      <div class="crow">
        <span class="clabel">Telefon · WhatsApp · iMessage</span>
        <span class="cvalue">+420 739 175 885</span>
        <span class="cvalue second">+420 736 728 936</span>
      </div>
      <div class="hr"></div>
      <div class="crow">
        <span class="clabel">E-mail</span>
        <span class="cvalue sm">info@zazijameriku.cz</span>
      </div>
    </div>

    <div class="back-footer">
      <div class="web">vykuphavarovanychvozu.cz</div>
      <div class="coverage">CZ · PL · SK · EU · Reagujeme každý den</div>
    </div>
  </div>

  <div class="vdiv"></div>

  <div class="back-right">
    <div class="qr-box">
      <img src="data:image/png;base64," alt="WhatsApp QR">
    </div>
    <div class="qr-sub">WhatsApp</div>
  </div>
</div>

</body>
</html>
